# Project Name for Docker / local containers
COMPOSE_PROJECT_NAME="acolyte-v4_0_2"

# Core Laravel config
APP_NAME="Acolyte R.E.A.L.M.S."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://acolyte.test
SESSION_SECURE_COOKIE=false


LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acolyte
DB_USERNAME=root
DB_ROOT_PASSWORD=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file

QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Active application filesystem disk.
# Local exploration usually uses `local`.
# Public archive demos for this archive typically use `digital_ocean`.
FILESYSTEM_DISK=local

# Legacy S3-compatible storage definition kept for archive continuity.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
DO_SPACES_AWS_REGION=
DO_SPACES_USE_PATH_STYLE_ENDPOINT=false
DO_SPACES_VISIBILITY=private

GOOGLE_CALENDAR_API_KEY=
SUPPORT_PASSWORD=

# Archive demo mode
DEMO_MODE=false
DEMO_ALLOW_WRITES=false
DEMO_ALLOW_BILLING=false
DEMO_ALLOW_MAIL=false
DEMO_ALLOW_UPLOADS=false

# Archive demo reset behavior
DEMO_RESET_ENABLED=false
DEMO_RESET_DISK=digital_ocean
DEMO_RESET_SEEDER=Database\\Seeders\\DemoSeeder
DEMO_RESET_WIPE_STRIPE_CUSTOMERS=false
DEMO_RESET_ALLOW_LIVE_STRIPE_KEYS=false

# Dedicated archive demo storage target.
# Prefer using a separate bucket/container from any legacy or real app storage.
DEMO_STORAGE_KEY=
DEMO_STORAGE_SECRET=
DEMO_STORAGE_REGION=sfo3
DEMO_STORAGE_BUCKET=
DEMO_STORAGE_ENDPOINT=
DEMO_STORAGE_AWS_REGION=us-east-1
DEMO_STORAGE_USE_PATH_STYLE_ENDPOINT=false
DEMO_STORAGE_VISIBILITY=private
